<?xml version="1.0" encoding="utf-8"?>
<!-- Generated shape: header, up to six filter buttons, the rows (a list that scrolls on Android 12 and later, else the rows that fit), and a footer with buttons and page arrows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/headbox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/dd_text"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/dd_muted"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/hprog"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_bar"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/pills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/p0"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/p1"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/p2"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/p3"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/p4"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/p5"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical" />
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:fadingEdgeLength="14dp"
        android:listSelector="@android:color/transparent"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/foot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <TextView
            android:id="@+id/f0"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/f1"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/f2"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/dd_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/pgprev"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="&#8249;"
            android:textColor="@color/dd_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/pginfo"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/dd_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/pgnext"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/pill_off_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="&#8250;"
            android:textColor="@color/dd_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
